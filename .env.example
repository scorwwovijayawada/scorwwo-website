# Copy this file to .env and fill in real values. Never commit the real .env file.

# ============================================================
# MAIN SCoRWWO SITE (contact form + AI chatbot)
# ============================================================
DB_HOST=localhost
DB_PORT=4000
DB_USER=root
DB_PASS=
DB_NAME=scorwwo_site

# ============================================================
# E-WORLD INTERNSHIP / STUDENT DASHBOARD
# (was previously its own separate app + DB deployed on Render;
#  now merged into this same server, with its own DB so it never
#  collides with the main site's DB_* values above)
# ============================================================
EWORLD_DB_HOST=localhost
EWORLD_DB_PORT=3306
EWORLD_DB_USER=root
EWORLD_DB_PASSWORD=password
EWORLD_DB_NAME=eworld_student_db
EWORLD_DB_SSL=false

EWORLD_JWT_SECRET=change_this_to_a_long_random_string
EWORLD_JWT_EXPIRES_IN=8h

# ============================================================
# SERVER
# ============================================================
PORT=3000
